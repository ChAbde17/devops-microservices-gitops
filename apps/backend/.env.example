# ── DevOps Backend Environment Variables ──
# Copy this file to .env and adjust values for your environment

APP_NAME=devops-backend
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL
DATABASE_URL=postgresql://devops:devops@localhost:5432/devops_db

# CORS (JSON list of allowed origins)
CORS_ORIGINS=["*"]